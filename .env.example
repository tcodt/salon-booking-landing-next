# تنظیمات لندینگ نارژین (Docker). کپی کنید:  cp .env.example .env   (یا ./deploy/setup.sh narjin.ir)
# برای حالت پیش‌فرض (فقط web پشت nginx موجود) هیچ‌کدام لازم نیست.

# --- پورت لندینگ روی میزبان ---
LANDING_BIND=127.0.0.1
LANDING_PORT=3000

# --- nginx خودِ لندینگ (فقط با --profile proxy) ---
DOMAIN=narjin.ir
# http = پشت Cloudflare/بالانسر  |  https = TLS با Let's Encrypt داخل همین nginx
NGINX_MODE=http
HTTP_PORT=80
HTTPS_PORT=443
LETSENCRYPT_DIR=./deploy/letsencrypt

# --- حالت «یک سرور» با API ---
EDGE_NETWORK=narjin_default

# --- ساخت تصویر ---
# روی سرورهایی که npmjs در دسترس نیست: https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org
